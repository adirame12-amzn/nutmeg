{
  "name": "nutmeg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "ingest:players": "python3 -m ingestion.pipeline",
    "ingest:rating-85": "python3 -m ingestion.rating_catalog --rating 85",
    "merge:rating-85-plus": "python3 -m ingestion.merge_catalogs --min-rating 85 --max-rating 91",
    "process:cutouts": "python3 -m ingestion.cutout_catalog",
    "ingest:paper-trail": "python3 -m ingestion.club_history",
    "backfill:club-crests": "python3 -m ingestion.crest_backfill",
    "test:ingestion": "python3 -m unittest discover -s ingestion/tests -p 'test_*.py'",
    "worker:seed": "python3 -m ingestion.export_worker_seed",
    "worker:typecheck": "tsc -p worker/tsconfig.json",
    "worker:migrate:local": "wrangler d1 migrations apply player-press-ranked --local --config worker/wrangler.jsonc",
    "worker:seed:local": "wrangler d1 execute player-press-ranked --local --config worker/wrangler.jsonc --file worker/seed.sql",
    "worker:dev": "wrangler dev --config worker/wrangler.jsonc --port 8787",
    "worker:migrate": "wrangler d1 migrations apply player-press-ranked --remote --config worker/wrangler.jsonc",
    "worker:seed:remote": "wrangler d1 execute player-press-ranked --remote --config worker/wrangler.jsonc --file worker/seed.sql",
    "worker:deploy": "wrangler deploy --config worker/wrangler.jsonc"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8",
    "wrangler": "^4.160.1"
  }
}
