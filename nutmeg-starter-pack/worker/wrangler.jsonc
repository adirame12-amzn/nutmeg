{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "player-press-ranked",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://adirame12-amzn.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "player-press-ranked",
      "database_id": "01ba7056-932e-4218-84b6-3aee0e03da24",
      "migrations_dir": "migrations"
    }
  ]
}
